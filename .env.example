# Copy to .env. No credentials are needed. Runtime is local only.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Download explicitly with scripts/download_models.py before running.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
MODEL_DIR=models
# auto attempts CUDA in an isolated process and retries on CPU if it fails.
# Use medium for lower memory use, or tiny for a quick pipeline smoke test.
